# 应用配置
APP_NAME=箱包采购与库存管理系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库（SQLite 相对 backend 目录）
DATABASE_URL=sqlite:///./data/app.db

# 上传归档目录（相对 backend 目录）：AI 识别到的原照片存这里
# 换目录后数据库里已存的相对路径依然有效，但老照片需要手工搬过去
UPLOAD_DIR=./data/uploads

# JWT
SECRET_KEY=bag-purchasing-inventory-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 跨域允许源（逗号分隔），开发期前端走 Vite 代理，此处用于直连。
# 最后一项 https://appassets.androidplatform.net 是 APK 内 WebView 的固定源，
# 打包成安卓 APK 后必须保留，否则手机端请求会被 CORS 预检拒绝。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://appassets.androidplatform.net

# AI 单据识别（OCR）
# provider 取值：
#   mock      离线演示引擎，无需密钥（默认）
#   dashscope 阿里云百炼 · 通义千问-VL   base_url/model 已内置预设
#   ark       火山方舟 · 豆包视觉         base_url/model 已内置预设
#   zhipu     智谱 GLM-4V                base_url/model 已内置预设
#   openai    OpenAI                     base_url/model 已内置预设
#   custom    自定义 OpenAI 兼容网关，需同时填写下面的 BASE_URL 与 MODEL
# 说明：BASE_URL / MODEL 留空即使用所选 provider 的预设；填了就以填写的为准。
AI_OCR_PROVIDER=mock
AI_OCR_API_KEY=
AI_OCR_BASE_URL=
AI_OCR_MODEL=
AI_OCR_TIMEOUT=60
AI_OCR_MAX_MB=8
# 是否携带 response_format={"type":"json_object"}（个别网关不支持请设为 false）
AI_OCR_JSON_MODE=true
# 网络异常/5xx 时的重试次数
AI_OCR_RETRY=1

# 操作日志
# 日志由中间件异步批量写入（不占请求链路），超期自动清理；RETENTION_DAYS=0 表示不清理
OPLOG_RETENTION_DAYS=90
OPLOG_BATCH_MAX=200
OPLOG_FLUSH_DELAY=0.3

# 登录保护：同一窗口期内连续失败达到次数即临时锁定
# 演示环境所有请求都来自 127.0.0.1，IP 维度的阈值要放宽，否则一个人输错会锁住所有人
LOGIN_MAX_FAILS=5
LOGIN_IP_MAX_FAILS=20
LOGIN_FAIL_WINDOW=300
LOGIN_LOCK_SECONDS=300
